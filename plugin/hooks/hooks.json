{
  "description": "Jira Planner advisory hooks — never block, only inform",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "TaskUpdate",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/task-delete-guard.sh"
          }
        ]
      },
      {
        "matcher": "mcp__plugin_atlassian_atlassian__createJiraIssue",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/jira-description-guard.sh"
          }
        ]
      },
      {
        "matcher": "mcp__plugin_atlassian_atlassian__editJiraIssue",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/jira-description-guard.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/plan-format-validator.sh"
          }
        ]
      }
    ]
  }
}
